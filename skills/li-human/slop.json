  "structures": [
    {"id": "not-just", "regex": "(?i)\\b(?:it'?s|this is|that'?s) not (?:just|only|merely) [^.!?\\n]{2,70}[,.;] (?:it'?s|this is|that'?s)\\b", "name": "\"It's not just X, it's Y\"", "fix": "State the Y directly. Cut the setup."},
    {"id": "not-only", "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b", "name": "\"Not only X but also Y\"", "fix": "Two plain sentences, or keep only the stronger half."},
    {"id": "no-x-no-y", "regex": "(?im)^no [^.!?\\n]{1,30}\\. no [^.!?\\n]{1,30}\\.", "name": "\"No X. No Y.\" staccato", "fix": "Say what there was, not a list of what there wasn't."},
    {"id": "triad", "regex": "(?i)\\b(\\w+), (\\w+),? and (\\w+)\\.", "name": "Rule-of-three triad ending a sentence", "fix": "Keep the one item that matters, or make the list uneven."},
    {"id": "reveal-question", "regex": "(?m)^\\s*(?:The (?:result|answer|catch|truth|kicker|twist|lesson|secret)|Why|How|What happened(?: next)?)\\?\\s*$", "name": "One-line rhetorical reveal (\"The result?\")", "fix": "Just say the result in the sentence before."},
    {"id": "emoji-markers", "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F447\\u2705\\U0001F4C8\\U0001F64C]", "name": "Stock LinkedIn emoji (rocket, fire, bulb, sparkles, dart, point-down, check)", "fix": "Delete them. If the line needs the emoji, the line is weak."},
    {"id": "hashtag-wall", "regex": "(?:#\\w+\\s*){4,}", "name": "Hashtag wall (4+ in a row)", "fix": "Three at most, at the bottom, only real ones."},
    {"id": "bait", "regex": "(?im)^\\s*(?:thoughts|agree|who else|am i (?:wrong|the only one)|what do you think|drop a comment|comment below|let me know (?:in the comments|below))\\??\\s*[\\.!]?\\s*$", "name": "Reflex engagement bait", "fix": "End on a question only this post could ask, or no question."},
    {"id": "colon-reveal", "regex": "(?m)^[A-Z][^:\\n]{2,40}:\\s*$", "name": "Short line ending in a colon as a drumroll", "fix": "Merge it into the line it introduces."},
    {"id": "in-a-world", "regex": "(?i)\\bin a world (?:where|of)\\b", "name": "\"In a world where...\" opener", "fix": "Start with the specific thing instead."},
    {"id": "imagine", "regex": "(?im)^imagine (?:a|if|being)\\b", "name": "\"Imagine if...\" opener", "fix": "Describe what actually happened."},
    {"id": "lets-dive", "regex": "(?i)\\blet'?s (?:dive|jump|get) (?:in|into|started)\\b", "name": "\"Let's dive in\"", "fix": "Delete it and start."}
  ]
